FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (metal gas);

// SS316L throughout. See README.md in this case folder for sources.

sigma           1.60;         // N/m, surface tension at Tm.

// Marangoni (thermocapillary) coefficient d(sigma)/dT, N/(m.K).
// This strongly sets the melt pool shape: more negative -> stronger outward
// surface flow -> wider, shallower pool. SS316L values in the literature range
// from about -0.8e-4 (low sulfur) to -4.3e-4 (Khairallah et al. 2016).
dsigmadT        -0.8e-4;

p0              101325.0;     // ambient pressure, Pa

Tvap            3090.0;
Mm              0.0558;       // kg/mol, Fe-dominated.
LatentHeatVap   7.45e6;       // J/kg, heat of vaporisation.

// ************************************************************************* //
